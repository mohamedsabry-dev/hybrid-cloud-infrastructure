[ansible]
ansible ansible_host=ansible.home.lab ansible_connection=local

[ipa]
ipa ansible_host=ipa.home.lab

[monitor]
monitor ansible_host=monitor.home.lab

[k8s]
k8s-master ansible_host=k8s-master.home.lab
k8s-worker1 ansible_host=k8s-worker1.home.lab
k8s-worker2 ansible_host=k8s-worker2.home.lab
k8s-worker3 ansible_host=k8s-worker3.home.lab

[vault]
vault-01 ansible_host=vault-01.home.lab
vault-02 ansible_host=vault-02.home.lab
vault-03 ansible_host=vault-03.home.lab

[jenkins_master]
jenkins-master ansible_host=jenkins-master.home.lab

[jenkins_agents]
ansible ansible_host=ansible.home.lab ansible_connection=local

# future agents here

[cicd:children]
jenkins_master
jenkins_agents

[all:vars]
ansible_user=super_ansible

# Command to run playbook with this inventory file:
# ansible-playbook -i Codes/Ansible-Playbooks/inventory your_playbook