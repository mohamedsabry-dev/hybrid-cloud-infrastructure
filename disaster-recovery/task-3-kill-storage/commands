# DR NAS Test — Command Reference

---

## Simulate NFS Outage

```bash
# Single worker NFS interface down
ssh root@k8s-worker1 'ip link set <nfs-interface> down'

# Restore
ssh root@k8s-worker1 'ip link set <nfs-interface> up'

# All workers
ssh root@k8s-worker1 'ip link set <nfs-interface> down'
ssh root@k8s-worker2 'ip link set <nfs-interface> down'
ssh root@k8s-worker3 'ip link set <nfs-interface> down'
```

---

## Monitor Pods

```bash
# All pods status + node
kubectl get pods -A -o wide

# Watch pods in real time
kubectl get pods -A -w

# Pods by namespace
kubectl get pods -n apps -o wide
kubectl get pods -n database -o wide
kubectl get pods -n monitoring -o wide
kubectl get pods -n kube-system | grep csi

# Describe stuck pod
kubectl describe pod <pod> -n <namespace>

# Pod logs
kubectl logs <pod> -n <namespace> --all-containers
kubectl logs -l app=wordpress -n apps
kubectl logs -l app=mariadb -n database -c mariadb
```

---

## Monitor Storage

```bash
# PVC status
kubectl get pvc -A

# PV status (check for Released)
kubectl get pv | grep Released
kubectl get pv -A

# CSI controller location
kubectl get pods -n kube-system -o wide | grep csi-nfs-controller

# CSI node pods
kubectl get pods -n kube-system -o wide | grep csi-nfs-node

# CSI controller logs
kubectl logs -n kube-system -l app=csi-nfs-controller -c nfs --tail=30

# CSI node logs on specific worker
kubectl logs -n kube-system <csi-nfs-node-pod> -c nfs --tail=30
```

