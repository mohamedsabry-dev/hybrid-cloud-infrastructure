# =============================================================================
# Proxmox Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git (it's in .gitignore)
# =============================================================================

# Proxmox Connection
proxmox_endpoint = "https://192.168.1.100:8006/"  # Replace with your Proxmox IP
proxmox_username = "root@pam"
proxmox_password = "your-secure-password"
proxmox_insecure = true  # Set to false if using valid SSL cert

# Node Configuration
proxmox_node = "proxmox-master"

# Network Bridges (created during Proxmox install)
network_bridges = {
  wan      = "vmbr0"  # Bridged to WAN
  internal = "vmbr1"  # Internal 10.0.20.x/24
  vmotion  = "vmbr2"  # Migration 10.0.30.x/24
}

# Storage
default_storage  = "local-lvm"
iso_storage      = "local"
template_storage = "local-lvm"
