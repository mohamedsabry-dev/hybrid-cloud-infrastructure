// Test pipeline: Jenkins Master → Vault (AppRole) → SSH Certificate → super_ansible → Kerberos → Ansible
// Jenkins Master handles Vault communication via HTTP API
// jenkins_agent receives certificate and uses it to become super_ansible

pipeline {
    agent { label 'ansible-vm-agent' }

    environment {
        VAULT_ADDR = 'http://10.0.20.192:8200'
    }

    stages {
        stage('Get SSH Certificate from Vault') {
            steps {
                script {
                    // Jenkins Master authenticates to Vault using AppRole credentials
                    withCredentials([
                        string(credentialsId: 'vault-approle-role-id', variable: 'ROLE_ID'),
                        string(credentialsId: 'vault-approle-secret-id', variable: 'SECRET_ID')
                    ]) {
                        // Step 1: Generate temporary SSH key pair on jenkins_agent
                        sh '''
                            ssh-keygen -t rsa -b 2048 -f /tmp/jenkins_temp_key -N "" -q
                            chmod 600 /tmp/jenkins_temp_key
                        '''

                        // Step 2: Read the public key
                        def publicKey = sh(script: 'cat /tmp/jenkins_temp_key.pub', returnStdout: true).trim()

                        // Step 3: Jenkins Master authenticates to Vault via HTTP API
                        def vaultToken = sh(script: """
                            curl -s -X POST ${VAULT_ADDR}/v1/auth/approle/login \
                                -d '{"role_id":"${ROLE_ID}","secret_id":"${SECRET_ID}"}' \
                                | jq -r '.auth.client_token'
                        """, returnStdout: true).trim()

                        echo "✅ Jenkins Master authenticated to Vault"

                        // Step 4: Request Vault to sign the SSH public key
                        sh """
                            curl -s -X POST ${VAULT_ADDR}/v1/ssh-client-signer/sign/ansible-role \
                                -H "X-Vault-Token: ${vaultToken}" \
                                -d '{"public_key":"${publicKey}","valid_principals":"super_ansible"}' \
                                | jq -r '.data.signed_key' > /tmp/jenkins_temp_key-cert.pub
                        """

                        echo "✅ Got signed SSH certificate from Vault"

                        // Store vault token for later use
                        env.VAULT_TOKEN = vaultToken
                    }
                }
            }
        }

        stage('Run as super_ansible with Kerberos') {
            steps {
                script {
                    // Step 5: jenkins_agent uses certificate to SSH as super_ansible
                    // Pass VAULT_TOKEN explicitly to the SSH session
                    def vaultToken = env.VAULT_TOKEN
                    sh """
                        ssh -i /tmp/jenkins_temp_key \
                            -o StrictHostKeyChecking=no \
                            super_ansible@localhost bash << 'REMOTE_SCRIPT'

                        # Now running as super_ansible on Ansible VM
                        export VAULT_ADDR=${VAULT_ADDR}
                        export VAULT_TOKEN=${vaultToken}

                        echo "🔍 Retrieving Kerberos keytab from Vault..."

                        # Step 6: Get Kerberos keytab from Vault
                        curl -s -H "X-Vault-Token: \${VAULT_TOKEN}" \
                            \${VAULT_ADDR}/v1/secret/data/cicd/kerberos/super_ansible \
                            | jq -r '.data.data.keytab' | base64 -d > /tmp/super_ansible.keytab

                        # Check if keytab was retrieved successfully
                        if [ ! -s /tmp/super_ansible.keytab ]; then
                            echo "❌ Failed to retrieve keytab from Vault"
                            exit 1
                        fi

                        chmod 600 /tmp/super_ansible.keytab

                        echo "✅ Retrieved Kerberos keytab from Vault"

                        # Step 7: Get Kerberos ticket
                        echo "🔍 Getting Kerberos ticket..."
                        kinit -kt /tmp/super_ansible.keytab super_ansible@HOME.LAB

                        if [ \$? -eq 0 ]; then
                            echo "✅ Got Kerberos ticket"
                            klist
                        else
                            echo "❌ Failed to get Kerberos ticket"
                            exit 1
                        fi

                        # Step 8: Run Ansible playbook
                        echo "🔍 Running Ansible playbook..."
                        ansible-playbook \
                            /opt/workspace/DC-K8s/03-AUTOMATION/ansible-playbooks/vault/01-node_preflight_check.yml \
                            -i /opt/workspace/DC-K8s/03-AUTOMATION/ansible-playbooks/inventory

                        echo "✅ Ansible playbook completed"

                        # Cleanup
                        rm -f /tmp/super_ansible.keytab
                        kdestroy
REMOTE_SCRIPT
                    """
                }
            }
        }
    }

    post {
        always {
            // Cleanup temporary keys and certificates
            sh '''
                rm -f /tmp/jenkins_temp_key /tmp/jenkins_temp_key.pub /tmp/jenkins_temp_key-cert.pub
            '''
        }
    }
}
