upstream k8s_workers {
    least_conn;
    server 10.0.54.10:30080;
    server 10.0.54.11:30080;
    server 10.0.54.12:30080;
}

server {
    listen 80;
    server_name nginx-test-prod.lab.local;

    access_log /var/log/nginx/nginx-test-prod.log upstream;

    # Allow large file uploads (WordPress media, etc.)
    client_max_body_size 500m;

    location / {
        proxy_pass http://k8s_workers;

        # Timeouts for large uploads
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
