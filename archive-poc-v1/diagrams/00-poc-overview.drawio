        <!-- ==================== STATUS BOX ==================== -->
        <mxCell id="status" value="&lt;b&gt;STATUS: ARCHIVED&lt;/b&gt;&lt;br&gt;Active: Dec 2025 - Jan 2026 (~2 months)&lt;br&gt;17 VMs • 64GB RAM • 4.5TB Storage&lt;br&gt;Retired: 10 reasons (see DESIGN.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;shadow=1;" vertex="1" parent="1">
