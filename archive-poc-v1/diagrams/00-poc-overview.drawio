        </mxCell>
        <mxCell id="vcenter" value="&lt;b&gt;vCenter&lt;/b&gt;&lt;br&gt;10.0.20.89&lt;br&gt;Cluster Mgmt&lt;br&gt;7GB • 3vCPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="infra_layer">
