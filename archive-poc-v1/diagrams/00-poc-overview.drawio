        <!-- DR ESXi -->
        <mxCell id="esxi_dr" value="&lt;b&gt;ESXi DR — Cold Standby (Powered OFF)&lt;/b&gt;&lt;br&gt;Mirrors Production • Manual failover • Saves 25.5GB RAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="esxi_master">
