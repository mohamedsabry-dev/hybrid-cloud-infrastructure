        <mxCell id="home_router" value="&lt;b&gt;Home Router&lt;/b&gt;&lt;br&gt;192.168.0.1&lt;br&gt;Internet Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="home_net">
          <mxGeometry x="15" y="38" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="mac_pc" value="&lt;b&gt;Mac PC&lt;/b&gt;&lt;br&gt;192.168.0.##&lt;br&gt;Management" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="home_net">
          <mxGeometry x="220" y="38" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="win_host" value="&lt;b&gt;Windows 11 Host&lt;/b&gt;&lt;br&gt;64GB RAM • 16vCPU&lt;br&gt;VMware Workstation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="home_net">
          <mxGeometry x="425" y="38" width="250" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== ESXI MASTER ==================== -->
