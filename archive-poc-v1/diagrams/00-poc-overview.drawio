        <!-- ==================== EDGES ==================== -->
        <mxCell id="edge_wan" value="VMnet0 Bridge (WAN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontColor=#333;fontSize=10;" edge="1" source="home_net" target="esxi_master" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_veeam" value="vCenter API (backup)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#333;fontSize=10;dashed=1;" edge="1" source="veeam_outer" target="esxi_master" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

