        <mxCell id="st_progression_label" value="&lt;b&gt;Progressive Failure Pattern (same root cause class):&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="storage_layer">
