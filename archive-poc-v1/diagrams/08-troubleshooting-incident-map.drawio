        </mxCell>
        <mxCell id="net_theme" value="&lt;b&gt;Common Theme:&lt;/b&gt; Nested virtualization creates unique network&lt;br&gt;challenges not seen in bare-metal deployments. Every network&lt;br&gt;issue traced back to VMware Workstation and ESXi interaction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="network_layer">
