        <!-- ==================== NETWORK INCIDENTS ==================== -->
        <mxCell id="network_layer" value="&lt;b&gt;Network — 4 Cases + 1 Reference Guide&lt;/b&gt;&lt;br&gt;Promiscuous mode, packet duplication, routing loops — all tied to nested virtualization complexity" style="swimlane;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
