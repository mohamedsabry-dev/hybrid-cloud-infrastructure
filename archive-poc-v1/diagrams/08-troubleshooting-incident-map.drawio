        <!-- ==================== STORAGE INCIDENTS ==================== -->
        <mxCell id="storage_layer" value="&lt;b&gt;Storage — 7 Cases (5 Critical) + 3 Reference Guides&lt;/b&gt;&lt;br&gt;Progressive failure pattern: same class of problem (snapshot mgmt on constrained hardware) hit repeatedly, each time deeper" style="swimlane;startSize=40;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
