        <mxCell id="st_07" value="&lt;b&gt;ST-07 CRITICAL&lt;/b&gt;&lt;br&gt;Snapshot Chain Corruption&lt;br&gt;Parent-child VMDK broken&lt;br&gt;Cross-drive snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="storage_layer">
