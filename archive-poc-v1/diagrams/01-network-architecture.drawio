        <mxCell id="dns_note" value="&lt;b&gt;DNS:&lt;/b&gt; Primary: IPA (10.0.20.184) • Secondary: pfSense (10.0.20.170) • Domain: home.lab • &lt;b&gt;NTP:&lt;/b&gt; All VMs → IPA (VMware Tools time sync DISABLED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lan_layer">
