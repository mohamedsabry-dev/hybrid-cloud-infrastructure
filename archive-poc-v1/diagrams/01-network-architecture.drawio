<mxfile host="app.diagrams.net">
  <diagram name="PoC v1 Network Architecture" id="poc-network">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== WAN NETWORK ==================== -->
        <mxCell id="wan_layer" value="&lt;b&gt;WAN — 192.168.0.x/24 (VMnet0 Bridged)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="110" as="geometry"/>
