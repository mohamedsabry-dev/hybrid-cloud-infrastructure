        </mxCell>
        <mxCell id="ew1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" source="wan_router" target="wan_pfsense" parent="wan_layer"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ==================== INTERNAL LAN ==================== -->
        <mxCell id="lan_layer" value="&lt;b&gt;Internal LAN — 10.0.20.x/24 (VMnet2 Host-Only)&lt;/b&gt;&lt;br&gt;All VM management traffic • Gateway: pfSense 10.0.20.170" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
