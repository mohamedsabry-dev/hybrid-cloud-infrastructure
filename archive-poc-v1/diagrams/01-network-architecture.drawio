        <mxCell id="edge_lan_vmot" value="isolated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d6b656;fontColor=#333;fontSize=10;dashed=1;" edge="1" source="lan_layer" target="vmotion_layer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

