        <mxCell id="wan_router" value="&lt;b&gt;Home Router&lt;/b&gt;&lt;br&gt;192.168.0.1&lt;br&gt;Internet Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="wan_layer">
          <mxGeometry x="15" y="38" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="wan_pfsense" value="&lt;b&gt;pfSense WAN&lt;/b&gt;&lt;br&gt;192.168.0.##&lt;br&gt;DHCP from home router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="wan_layer">
