<mxfile host="app.diagrams.net">
  <diagram name="PoC v1 Automation and CI/CD" id="poc-automation">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== ANSIBLE AUTOMATION ==================== -->
        <mxCell id="ansible_layer" value="&lt;b&gt;Ansible Automation — super_ansible (Kerberos keytab, passwordless sudo)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
