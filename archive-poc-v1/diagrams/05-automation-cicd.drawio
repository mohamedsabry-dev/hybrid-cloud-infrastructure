        <mxCell id="ipa_auto_label" value="&lt;b&gt;FreeIPA Setup (5 phases):&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="ansible_layer">
