        <mxCell id="ipa_04" value="&lt;b&gt;04&lt;/b&gt; Configure&lt;br&gt;Sudo Rules&lt;br&gt;6 privilege rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="ansible_layer">
