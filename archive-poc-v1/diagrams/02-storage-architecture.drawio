<mxfile host="app.diagrams.net">
  <diagram name="PoC v1 Storage Architecture" id="poc-storage">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== PHYSICAL STORAGE ==================== -->
        <mxCell id="physical" value="&lt;b&gt;Physical Storage — 4.5TB Total&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nvme0" value="&lt;b&gt;NVME0 (2TB)&lt;/b&gt;&lt;br&gt;Windows 11 + personal data" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="physical">
          <mxGeometry x="15" y="38" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="nvme1" value="&lt;b&gt;NVME1 (2TB)&lt;/b&gt;&lt;br&gt;VMware Workstation VMs&lt;br&gt;DS_NVME_1 + DS_NVME_2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="physical">
          <mxGeometry x="300" y="38" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="nvme2" value="&lt;b&gt;NVME2 (500GB)&lt;/b&gt;&lt;br&gt;External DR backups (SMB)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="physical">
          <mxGeometry x="615" y="38" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="over_prov" value="&lt;b&gt;Over-provisioning: 2.3x&lt;/b&gt;&lt;br&gt;4.2TB allocated / 1.8TB actual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="physical">
          <mxGeometry x="900" y="38" width="250" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== DS_NVME_1 ==================== -->
        <mxCell id="ds1" value="&lt;b&gt;DS_NVME_1 — ESXi Datastore (2TB Thin)&lt;/b&gt;&lt;br&gt;Provisioned: 1.52TB • Free: 600GB" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="690" height="130" as="geometry"/>
