        <mxCell id="ds1_vc" value="&lt;b&gt;vCenter&lt;/b&gt;&lt;br&gt;500GB thin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ds1">
