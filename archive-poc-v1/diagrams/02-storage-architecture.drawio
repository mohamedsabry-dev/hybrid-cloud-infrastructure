        </mxCell>
        <mxCell id="ds1_veeam" value="&lt;b&gt;Veeam&lt;/b&gt;&lt;br&gt;80GB OS&lt;br&gt;600GB repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="ds1">
          <mxGeometry x="130" y="48" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ds1_pf" value="&lt;b&gt;pfSense&lt;/b&gt;&lt;br&gt;40GB thin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="ds1">
          <mxGeometry x="250" y="48" width="100" height="45" as="geometry"/>
