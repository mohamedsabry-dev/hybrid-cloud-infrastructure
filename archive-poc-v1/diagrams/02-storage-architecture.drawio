          <mxGeometry x="170" y="68" width="150" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_v3" value="&lt;b&gt;vault-03&lt;/b&gt;&lt;br&gt;30GB OS + 10GB RAID1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="330" y="68" width="150" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nfs_k8s_label" value="&lt;b&gt;Kubernetes:&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="nfs_layer">
          <mxGeometry x="510" y="48" width="120" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_km" value="&lt;b&gt;k8s-master&lt;/b&gt;&lt;br&gt;90GB OS + 120GB data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="510" y="68" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_kw" value="&lt;b&gt;k8s-workers ×3&lt;/b&gt;&lt;br&gt;50GB OS + 60GB data each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="680" y="68" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nfs_svc_label" value="&lt;b&gt;Support Services:&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="nfs_layer">
          <mxGeometry x="890" y="48" width="150" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_ans" value="&lt;b&gt;ansible&lt;/b&gt;&lt;br&gt;90GB OS + 120GB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="890" y="68" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_jen" value="&lt;b&gt;jenkins&lt;/b&gt;&lt;br&gt;90GB OS + 60GB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="1040" y="68" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_mon" value="&lt;b&gt;monitor&lt;/b&gt;&lt;br&gt;90GB OS + 60GB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="nfs_layer">
          <mxGeometry x="1180" y="68" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nfs_total" value="&lt;b&gt;Total Allocated:&lt;/b&gt; 780GB / 900GB • &lt;b&gt;Free:&lt;/b&gt; 120GB • &lt;b&gt;NAS_DS_2 (5GB):&lt;/b&gt; HA Heartbeat datastore • &lt;b&gt;Thick provisioned:&lt;/b&gt; NAS data disks only (predictable NFS I/O)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="nfs_layer">
          <mxGeometry x="10" y="125" width="1100" height="35" as="geometry"/>
        </mxCell>

        <!-- ==================== PROVISIONING STRATEGY ==================== -->
        <mxCell id="strategy" value="&lt;b&gt;Provisioning Strategy&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="strat_thin" value="&lt;b&gt;Thin Provisioned (default)&lt;/b&gt;&lt;br&gt;Most VMs • Grows on demand&lt;br&gt;Risk: snapshot captures full allocated size" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="strategy">
          <mxGeometry x="15" y="38" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="strat_thick" value="&lt;b&gt;Thick Provisioned (NAS only)&lt;/b&gt;&lt;br&gt;Predictable NFS performance&lt;br&gt;Rule: 2x disk for snapshot safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="strategy">
          <mxGeometry x="370" y="38" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="strat_snap" value="&lt;b&gt;Snapshot Risk&lt;/b&gt;&lt;br&gt;Thick disk snapshots capture entire allocation&lt;br&gt;980GB thick + snapshot = disk full disaster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="strategy">
          <mxGeometry x="725" y="38" width="340" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES ==================== -->
        <mxCell id="edge_phys_ds1" value="hosts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#333;fontSize=10;" edge="1" source="physical" target="ds1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_phys_ds2" value="hosts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#333;fontSize=10;" edge="1" source="physical" target="ds2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_ds2_nfs" value="NFS export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d6b656;fontColor=#333;fontSize=10;" edge="1" source="ds2" target="nfs_layer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_nfs_strat" value="provisioning rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#999999;fontColor=#666;fontSize=10;" edge="1" source="nfs_layer" target="strategy" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
