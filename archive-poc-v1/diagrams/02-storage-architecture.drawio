        <mxCell id="ds1_prod" value="&lt;b&gt;ESXi Prod&lt;/b&gt;&lt;br&gt;150GB thin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="ds1">
          <mxGeometry x="360" y="48" width="100" height="45" as="geometry"/>
