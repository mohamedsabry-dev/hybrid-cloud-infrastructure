        <mxCell id="ds1_dr" value="&lt;b&gt;ESXi DR&lt;/b&gt;&lt;br&gt;150GB thin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;dashed=1;" vertex="1" parent="ds1">
          <mxGeometry x="470" y="48" width="100" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ds1_iso" value="&lt;b&gt;ISOs&lt;/b&gt;&lt;br&gt;50GB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ds1">
          <mxGeometry x="580" y="48" width="100" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== DS_NVME_2 ==================== -->
        <mxCell id="ds2" value="&lt;b&gt;DS_NVME_2 — NAS Dedicated (2TB)&lt;/b&gt;&lt;br&gt;Provisioned: 935GB • Free: 1TB" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="180" width="400" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ds2_os" value="&lt;b&gt;NAS VM OS&lt;/b&gt;&lt;br&gt;30GB thin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ds2">
          <mxGeometry x="15" y="48" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ds2_data" value="&lt;b&gt;NAS VM Data&lt;/b&gt;&lt;br&gt;900GB + 5GB&lt;br&gt;THICK provisioned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="ds2">
          <mxGeometry x="185" y="48" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== NAS NFS EXPORTS ==================== -->
        <mxCell id="nfs_layer" value="&lt;b&gt;NAS_DS — NFS Export from NAS VM (900GB)&lt;/b&gt;&lt;br&gt;Shared storage for all production VMs • Enables vMotion" style="swimlane;startSize=40;fillColor=#ffe6cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1420" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="nfs_vault_label" value="&lt;b&gt;Vault Cluster:&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="nfs_layer">
