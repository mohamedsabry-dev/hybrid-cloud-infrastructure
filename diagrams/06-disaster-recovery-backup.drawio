        </mxCell>
        <mxCell id="etcd_cj" value="&lt;b&gt;etcd-backup CronJob&lt;/b&gt;&lt;br&gt;Nightly schedule&lt;br&gt;Runs on K8s master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="s1">
