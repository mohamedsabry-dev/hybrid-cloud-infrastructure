        <mxCell id="s2" value="&lt;b&gt;VM / LXC WORKLOAD BACKUPS — Proxmox → NAS&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
