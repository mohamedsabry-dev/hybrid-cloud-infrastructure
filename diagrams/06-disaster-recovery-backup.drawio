        </mxCell>
        <mxCell id="etcd_snap" value="&lt;b&gt;etcdctl snapshot&lt;/b&gt;&lt;br&gt;Save cluster state&lt;br&gt;/tmp/etcd-snapshot.db" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s1">
