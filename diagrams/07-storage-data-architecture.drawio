        <mxCell id="s4" value="&lt;b&gt;PVC LIFECYCLE — Claim → Provision → Mount → Reclaim&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="505" width="1320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pvc_claim" value="&lt;b&gt;PVC Created&lt;/b&gt;&lt;br&gt;StatefulSet volumeClaimTemplate&lt;br&gt;or standalone PVC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="15" y="40" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pvc_prov" value="&lt;b&gt;PV Provisioned&lt;/b&gt;&lt;br&gt;CSI creates NFS subdir&lt;br&gt;on NAS volume" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="310" y="40" width="220" height="60" as="geometry"/>
        </mxCell>
