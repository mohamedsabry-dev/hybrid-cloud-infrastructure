          <mxGeometry x="680" y="318" width="40" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;CSI-NFS DRIVER — Dynamic Provisioning&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="csi_ds" value="&lt;b&gt;NFS CSI DaemonSet&lt;/b&gt;&lt;br&gt;Runs on all K8s nodes&lt;br&gt;HelmRelease via Flux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="15" y="40" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="csi_ctrl" value="&lt;b&gt;CSI Controller&lt;/b&gt;&lt;br&gt;Provisions PVs on demand&lt;br&gt;Creates NFS subdirectories" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="290" y="40" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="csi_mount" value="&lt;b&gt;Mount Path&lt;/b&gt;&lt;br&gt;NAS:10.0.40.4 → VLAN 40&lt;br&gt;Worker 2nd NIC (storage-only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="585" y="40" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="csi_tf" value="&lt;b&gt;Terraform Provisioned&lt;/b&gt;&lt;br&gt;NAS mount points created&lt;br&gt;by proxmox/storage/nas module" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="890" y="40" width="260" height="60" as="geometry"/>
        </mxCell>
