        <mxCell id="worker_nic" value="&lt;b&gt;Worker 2nd NIC&lt;/b&gt;&lt;br&gt;Dedicated storage NIC&lt;br&gt;Bypasses hypervisor in data path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s5">
