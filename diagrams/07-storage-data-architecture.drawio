          <mxGeometry x="575" y="40" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pvc_retain" value="&lt;b&gt;Retain Policy&lt;/b&gt;&lt;br&gt;PVC deleted → PV Released&lt;br&gt;NAS data preserved&lt;br&gt;Manual cleanup required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="830" y="40" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pvc_immut" value="&lt;b&gt;Immutable after create&lt;/b&gt;&lt;br&gt;StatefulSet PVCs can't&lt;br&gt;change StorageClass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="s4">
