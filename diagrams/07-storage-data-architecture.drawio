        </mxCell>
        <mxCell id="vlan40" value="&lt;b&gt;VLAN 40 (Storage)&lt;/b&gt;&lt;br&gt;L2 isolated&lt;br&gt;10.0.40.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="15" y="40" width="200" height="60" as="geometry"/>
