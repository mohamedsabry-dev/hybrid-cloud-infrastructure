        </mxCell>
        <mxCell id="nas_hw" value="&lt;b&gt;Asustor NAS&lt;/b&gt;&lt;br&gt;1.8TB total capacity&lt;br&gt;RAID1 mirrored disks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s1">
