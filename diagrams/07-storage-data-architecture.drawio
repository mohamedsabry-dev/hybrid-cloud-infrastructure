        <mxCell id="s2" value="&lt;b&gt;KUBERNETES STORAGE CLASSES — Mount Behavior Selection&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="1320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="sc_retain" value="&lt;b&gt;nfs-retain&lt;/b&gt;&lt;br&gt;Soft mount, 30s timeout&lt;br&gt;Returns IO errors fast&lt;br&gt;Good for stateless apps&lt;br&gt;&lt;i&gt;Prometheus, Grafana, Loki, WordPress&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="15" y="38" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="sc_db" value="&lt;b&gt;nfs-database&lt;/b&gt;&lt;br&gt;Hard mount, 600s timeout&lt;br&gt;Hangs until NAS recovers&lt;br&gt;Required for InnoDB integrity&lt;br&gt;&lt;i&gt;MariaDB only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="370" y="38" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="sc_delete" value="&lt;b&gt;nfs-delete&lt;/b&gt;&lt;br&gt;Soft mount, 30s timeout&lt;br&gt;PV + NAS data removed on PVC delete&lt;br&gt;Ephemeral / test workloads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="725" y="38" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="nfs_ver" value="&lt;b&gt;NFSv3 Pinned&lt;/b&gt;&lt;br&gt;nfsvers=3, nolock&lt;br&gt;v4.2 lock manager&lt;br&gt;flaky across VLANs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="1080" y="38" width="210" height="75" as="geometry"/>
        </mxCell>

