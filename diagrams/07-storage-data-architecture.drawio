        <mxCell id="s5" value="&lt;b&gt;NETWORK ISOLATION — VLAN 40 Storage Path&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;collapsible=0;fontSize=12;shadow=1;" vertex="1" parent="1">
