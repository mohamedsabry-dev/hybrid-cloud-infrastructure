        <mxCell id="ec2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" source="csi_ctrl" target="csi_mount" parent="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" source="csi_mount" target="csi_tf" parent="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

