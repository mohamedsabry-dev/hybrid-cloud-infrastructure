Commands provided:

# List block devices
  lsblk -o NAME,MODEL,SIZE,ROTA,TYPE

# Full SMART data
  smartctl -a /dev/nvme0n1 | less

# Specific red-flag scan
  smartctl -a /dev/nvme0n1 | grep -iE 'critical|media_errors|error_log|
    percentage_used|unsafe_shutdown|temperature'

# Red flags to watch:
  - Reallocated_Sector_Ct > 0
  - Current_Pending_Sector > 0
  - Offline_Uncorrectable > 0
  - UDMA_CRC_Error_Count > 0 (bad cable)
  - NVMe Percentage Used > 80%
  - Media and Data Integrity Errors > 0

# Short SMART test
  smartctl -t short /dev/nvme0n1
  sleep 120
  smartctl -l selftest /dev/nvme0n1

# Long SMART test (overnight)
  smartctl -t long /dev/nvme0n1

