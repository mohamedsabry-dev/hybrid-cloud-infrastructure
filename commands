# WireGuard Tunnel Monitoring Commands
# =====================================

## AWS EC2 (172.16.65.192)
## -----------------------

# 1. Continuous ping to home server (background)
nohup bash -c 'ping 10.0.5.110 | while read line; do echo "$(date "+%H:%M:%S") $line"; done' > ~/ping.log 2>&1 &

# 2. Monitor WireGuard handshake every 30 seconds (background)
nohup bash -c 'while true; do echo "$(date "+%H:%M:%S") $(sudo wg show wg0 latest-handshakes)"; sleep 30; done' > ~/handshake.log 2>&1 &

# 3. Capture WireGuard traffic on port 51820 (background)
nohup sudo tcpdump -i enX0 udp port 51820 -n -tt > ~/wg-traffic.log 2>&1 &


## Home Server / Proxmox (10.0.5.110)
## ----------------------------------

# 1. Continuous ping to AWS WireGuard (background)
nohup bash -c 'ping 172.16.65.192 | while read line; do echo "$(date "+%H:%M:%S") $line"; done' > ~/ping.log 2>&1 &


## Check Logs Tomorrow
## -------------------

# On AWS:
tail -100 ~/ping.log          # Check for gaps/timeouts
tail -100 ~/handshake.log     # Check handshake timestamps
tail -100 ~/wg-traffic.log    # Check packet flow

# On Home Server:
tail -100 ~/ping.log          # Check for gaps/timeouts

# Quick WireGuard status:
sudo wg show


## What to Look For
## ----------------

# 1. ping.log - Look for "Request timeout" or gaps in timestamps
#    - Gaps = tunnel was down during that time
#    - Consistent ~60ms = healthy

# 2. handshake.log - Unix timestamp should change every ~2 minutes
#    - Same timestamp for 5+ minutes = stale tunnel
#    - Convert timestamp: date -d @<timestamp>

# 3. wg-traffic.log - Should see bidirectional traffic
#    - Only outbound (172.16.65.192 -> 196.x.x.x) = home not responding
#    - Only inbound = AWS not responding


