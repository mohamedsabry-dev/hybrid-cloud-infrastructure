ANSIBLE LXC BOOTSTRAP (First Time Only):
Manual setup:
bash# 1. Deploy LXC from Rocky template (online)
pct create 300 local:vztmpl/rocky-9-default.tar.xz

# 2. SSH into Ansible LXC as root

# 3. Install Ansible
dnf install -y ansible python3 git

# 4. Install common tools
dnf install -y vim htop curl wget net-tools

# 5. Join IPA domain
ipa-client-install

# 6. Create ansible_bot user locally
useradd ansible_bot

# 7. Get keytab from Vault (manual first time)
vault kv get -field=keytab secret/ansible/bot > /home/ansible_bot/.keytab
chown ansible_bot:ansible_bot /home/ansible_bot/.keytab
chmod 600 /home/ansible_bot/.keytab

# 8. Setup auto-renewal cron
crontab -u ansible_bot -e
# Add: */5 * * * * kinit -kt /home/ansible_bot/.keytab ansible_bot

# 9. Clone playbooks repo
git clone https://github.com/your-repo /opt/ansible

# 10. Test
sudo -u ansible_bot ansible-playbook --version
