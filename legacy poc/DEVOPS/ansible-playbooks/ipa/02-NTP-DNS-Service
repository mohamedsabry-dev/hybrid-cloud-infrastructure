---
- name: Configure All VMs to Use IPA as NTP Server
  hosts: all:!ipa
  become: yes
  vars:
    ipa_server: "ipa.home.lab"

  tasks:
    - name: Backup current chrony configuration
      copy:
        src: /etc/chrony.conf
        dest: /etc/chrony.conf.backup
        remote_src: yes

    - name: Remove all existing NTP server entries
      lineinfile:
        path: /etc/chrony.conf
        regexp: '^(server|pool)\s+'
        state: absent

    - name: Configure IPA as the primary NTP server
      lineinfile:
        path: /etc/chrony.conf
        line: "server {{ ipa_server }} iburst"
        insertafter: "^# Use public servers"
        state: present

    - name: Restart chronyd service
      service:
        name: chronyd
        state: restarted
        enabled: yes

    - name: Wait for chrony to sync
      wait_for:
        timeout: 10

    - name: Force chrony to sync immediately
      command: chronyc makestep
      ignore_errors: yes

    - name: Verify new NTP configuration
      command: chronyc sources
      register: new_sources
      changed_when: false

    - name: Display new NTP sources
      debug:
        msg: "{{ new_sources.stdout_lines }}"

- name: Verify IPA Server NTP Configuration
  hosts: ipa
  become: yes

  tasks:
    - name: Check IPA NTP sources (should use external)
      command: chronyc sources
      register: ipa_sources
      changed_when: false

    - name: Display IPA NTP sources
      debug:
        msg:
          - "IPA server should sync to external sources:"
          - "{{ ipa_sources.stdout_lines }}"