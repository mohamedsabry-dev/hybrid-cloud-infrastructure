- name: Onboard Rocky Linux VMs to Solid Land
  hosts: all:!ipa
  become: yes
  tags: phase2
  vars:


  tasks:
    - name: Configure DNS via nmcli (IPA Primary, pfSense Secondary)
      community.general.nmcli:
        conn_name: "ens33"
        type: ethernet
        dns4:                     # Use dns4 for IPv4
          - "{{ ipa_primary }}"
          - "{{ pfsense_gw }}"
        dns4_search:              # Use dns4_search
          - "{{ domain }}"
        state: present
        conn_reload: yes          # Tells NetworkManager to reload the config

#   - name: Force connection up to apply DNS
#     ansible.builtin.shell: nmcli connection up ens33


    - name: Read /etc/resolv.conf for verification
      ansible.builtin.command: cat /etc/resolv.conf
      register: dns_output
      changed_when: false


    - name: Display DNS Resolution on each Host
      ansible.builtin.debug:
        msg: "{{ dns_output.stdout_lines }}"



